# ==============================================================================
# Bale Control Panel for Telegram Account - Environment Configuration
# ==============================================================================

# 1. Bale Bot Credentials (Get from @BotFather on Bale Messenger)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
BALE_BASE_URL=https://tapi.bale.ai/bot
BALE_FILE_URL=https://tapi.bale.ai/file/bot

# 2. Telegram MTProto User Account Credentials (Get from https://my.telegram.org)
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# 3. Telethon Session File Path (Relative or Absolute)
# Default persists to the data/ directory mounted in Docker
TELEGRAM_SESSION=data/telegram.session

# 4. Authorized Controller Bale User IDs (Comma-separated integer Bale IDs)
# Only these Bale users will be allowed to interact with the control panel bot.
AUTHORIZED_USER_IDS=123456789,987654321

# 5. Database URL (SQLAlchemy async connection string)
# SQLite for quick local development:
DATABASE_URL=sqlite+aiosqlite:///data/app.db
# PostgreSQL for production / Docker Compose:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/tgcontrol

# 6. Redis URL (Optional - in-memory fallback is automatically used if omitted/unavailable)
REDIS_URL=redis://redis:6379/0

# 7. Application Storage & Directories
TEMP_DIR=tmp
DATA_DIR=data

# 8. Operational Settings
LOG_LEVEL=INFO
ENVIRONMENT=production
DEFAULT_MESSAGES_PER_PAGE=10
DEFAULT_CHATS_PER_PAGE=6
CLEANUP_INTERVAL_MINUTES=30

# 9. Telegram Account Hardening & Safety Controls
# Centralized rate limiting (operations per second globally)
TELEGRAM_RATE_LIMIT_GLOBAL=5.0
# Minimum spacing between operations directed to the same chat (seconds)
TELEGRAM_PER_CHAT_RATE_LIMIT=1.0
# Maximum concurrent MTProto requests allowed simultaneously
TELEGRAM_MAX_CONCURRENT_REQUESTS=3
# Maximum concurrent media upload/download operations
TELEGRAM_MAX_CONCURRENT_MEDIA=2
# Bounded queue limit for pending Telegram requests before fast-failing
TELEGRAM_REQUEST_QUEUE_MAX_SIZE=50

# 10. FloodWait & Error Retries
# Automatically sleep and retry if Telegram FloodWait requirement is <= this threshold (seconds)
# FloodWaits exceeding this limit immediately fail without holding resources
TELEGRAM_AUTO_FLOOD_WAIT_MAX=10
# Maximum retry attempts for transient network glitches
TELEGRAM_MAX_RETRIES=3
# Base exponential backoff delay (seconds)
TELEGRAM_RETRY_BASE_DELAY=1.0
# Maximum backoff delay cap (seconds)
TELEGRAM_RETRY_MAX_DELAY=10.0
# Maximum random jitter added to retry delay to prevent thundering herd (seconds)
TELEGRAM_RETRY_JITTER=0.5

# 11. Circuit Breaker / Safety Shutoff
# Consecutive failures before tripping circuit breaker to pause operations
TELEGRAM_CIRCUIT_BREAKER_FAILURES=5
# Cooldown period in seconds before attempting recovery
TELEGRAM_CIRCUIT_BREAKER_COOLDOWN=30.0

# 12. Caching TTLs (seconds)
# Chat metadata cache TTL
TELEGRAM_CACHE_TTL_CHATS=300
# Dialogs list cache TTL
TELEGRAM_CACHE_TTL_DIALOGS=30
# Chat permissions cache TTL
TELEGRAM_CACHE_TTL_PERMISSIONS=120
# Message history and single message cache TTL
TELEGRAM_CACHE_TTL_MESSAGES=60
# Resolved peers / usernames cache TTL
TELEGRAM_CACHE_TTL_PEERS=600

# 13. UI Deduplication & Activity-Conscious Read Receipts
# Debounce window in seconds to ignore or coalesce repeated identical button taps
TELEGRAM_DEDUPLICATION_WINDOW=2.0
# Send message read acknowledgements only when controller actively opens/inspects a chat
TELEGRAM_AUTO_READ_ON_INSPECT=true

